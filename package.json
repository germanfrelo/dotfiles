{
	"name": "dotfiles",
	"version": "0.1.0",
	"private": true,
	"description": "My dotfiles, managed with chezmoi.",
	"keywords": [
		"dotfiles",
		"macos",
		"chezmoi"
	],
	"homepage": "https://github.com/germanfrelo/dotfiles",
	"bugs": {
		"url": "https://github.com/germanfrelo/dotfiles/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/germanfrelo/dotfiles.git"
	},
	"license": "MIT",
	"author": "Germán Freixinós",
	"type": "module",
	"main": "",
	"scripts": {
		"format": "prettier --write . && npm run format:shell",
		"format:check": "prettier --check . && npm run format:shell:check",
		"format:shell": "git ls-files -z '*.sh' '*.sh.tmpl' '.husky/*' '*zshrc' '*zshenv' ':!.husky/_/**' | xargs -0 env SHUCK_EXPERIMENTAL=1 shuck format",
		"format:shell:check": "git ls-files -z '*.sh' '*.sh.tmpl' '.husky/*' '*zshrc' '*zshenv' ':!.husky/_/**' | xargs -0 env SHUCK_EXPERIMENTAL=1 shuck format --check",
		"lint:shell": "git ls-files -z '*.sh' '*.sh.tmpl' '.husky/*' '*zshrc' '*zshenv' ':!.husky/_/**' | xargs -0 shuck check",
		"managed": "node scripts/managed.js > MANAGED.txt",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.*": [
			"prettier --write --ignore-unknown"
		],
		"{**/*.sh,**/*.sh.tmpl,.husky/!(_)*,**/*zshrc,**/*zshenv}": [
			"env SHUCK_EXPERIMENTAL=1 shuck format",
			"shuck check"
		]
	},
	"devDependencies": {
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"prettier-plugin-multiline-arrays": "4.1.11"
	}
}
