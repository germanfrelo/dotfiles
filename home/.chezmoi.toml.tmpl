{{- $machine_type := promptChoiceOnce . "machine_type" "Machine type" (list "personal" "work") -}}
{{- $source_dir := joinPath .chezmoi.homeDir "repos/germanfrelo/dotfiles" -}}
{{- if eq $machine_type "work" -}}
{{-   $source_dir = promptStringOnce . "source_dir" "Dotfiles source directory" -}}
{{- end -}}

# Refs.:
# https://www.chezmoi.io/user-guide/setup/
# https://www.chezmoi.io/reference/configuration-file/

# Ref. https://www.chezmoi.io/reference/configuration-file/variables/#sourcedir
sourceDir = {{ $source_dir | quote }}

# Ref. https://www.chezmoi.io/user-guide/manage-machine-to-machine-differences/
[data]
	machine_type = {{ $machine_type | quote }}

# --- TOOLS ---

# Editor
# https://www.chezmoi.io/user-guide/tools/editor/
# IMPORTANT: Do NOT set 'edit.command'. By default, chezmoi uses the text editor defined via the '$VISUAL' shell environment variable in '$ZDOTDIR/.zshrc'. This is the desired behavior.

# Diff
# https://www.chezmoi.io/user-guide/tools/diff/
[diff]
	command = "code"
	args = ["--wait", "--diff"]

# Merge
# https://www.chezmoi.io/user-guide/tools/merge/
[merge]
	command = "bash"
	args = [
		"-c",
		{{ `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` | quote }},
]

# ---

# Show human-friendly diffs for binary files.
# Ref. https://www.chezmoi.io/user-guide/tools/diff/#show-human-friendly-diffs-for-binary-files
[[textconv]]
	pattern = "**/*.plist"
	command = "plutil"
	args = ["-convert", "xml1", "-o", "-", "-"]
