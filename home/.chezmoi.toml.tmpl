# ========================================
# chezmoi config file template
# https://www.chezmoi.io/reference/special-files/chezmoi-format-tmpl/
# ========================================

# ----- CORE CONFIGURATION -----

# Persists the custom source directory passed via '--source' during 'chezmoi init' so future commands remember it.
sourceDir = {{ .chezmoi.sourceDir | quote }}

# ----- TEMPLATE DATA -----

# Prompts the user to choose the machine type during 'chezmoi init'.
{{- $machine_type := promptChoiceOnce . "machine_type" "Machine type" (list "personal" "work") -}}
[data]
	machine_type = {{ $machine_type | quote }}

# ----- EDITOR -----

# ❗️ IMPORTANT: Do NOT set 'edit.command'. By default, chezmoi uses the text editor defined via the '$VISUAL' shell environment variable in '$ZDOTDIR/.zshrc'. This is the desired behavior.

# ----- DIFF -----

# Use VS Code as the diff tool.
[diff]
	command = "code"
	args = ["--wait", "--diff"]

# Show human-friendly diffs for binary files.
[[textconv]]
	pattern = "**/*.plist"
	command = "plutil"
	args = ["-convert", "xml1", "-o", "-", "-"]

# ----- MERGE -----

# Use VS Code as the merge tool.
[merge]
	command = "bash"
	args = [
		"-c",
		{{ `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` | quote }},
]
