# shellcheck shell=zsh

# ========================================
# Zsh environment bootstrapper
# https://github.com/romkatv/zsh4humans/blob/v5/tips.md#alternative-zdotdir
#
# ⚠️ WARNING: Do NOT modify this file or move it out of `~/.zshenv`.
# Required by zsh4humans when Zsh configuration files are relocated to `$ZDOTDIR` (`~/.config/zsh`).
# ========================================

ZDOTDIR=~/.config/zsh
source -- "$ZDOTDIR"/.zshenv
