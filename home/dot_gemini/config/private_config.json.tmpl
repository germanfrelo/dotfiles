{
  "plugins": {
    "modern-web-guidance-plugin": {
      "enabled": true
    }
  },
  "userSettings": {
    "customThemeSeedsDark": {
      "background": "#101010",
      "foregroundOverride": "#FFFFFF",
      "primary": "#007acc"
    },
    "customThemeSeedsLight": {
      "background": "#FFFFFF",
      "foregroundOverride": "#101010",
      "primary": "#007acc"
    },
    "globalPermissionGrants": {
      "allow": [
        "command(cat)",
        "command(echo)",
        "command(find)",
        "command(git diff)",
        "command(git grep)",
        "command(git log)",
        "command(git ls-files)",
        "command(git ls-tree)",
        "command(git show)",
        "command(git status)",
        "command(grep)",
        "command(head)",
        "command(ls)",
        "command(tail)",
        "command(wc)",
        "read_url(agentskills.io)",
        "read_url(antigravity.google)",
        "read_url(chezmoi.io)",
        "read_url(code.visualstudio.com)",
        "read_url(git-scm.com)",
        "read_url(raw.githubusercontent.com)"
      ]
    },
    "permissionGrantsV2Migrated": true,
    "remoteControlEnabled": true,
    "remoteControlHostname": "{{ .chezmoi.hostname }}",
    "sandboxEnabledAtV2Migration": true,
    "themeMode": "THEME_MODE_INHERIT"
  }
}
