{
  "plugins": {
    "modern-web-guidance-plugin": {
      "enabled": true,
      "installedFrom": {
        "id": "antigravity-plugins-official/plugin/modern-web-guidance-plugin",
        "marketplace": "antigravity-plugins-official",
        "version": "1.0.6"
      }
    }
  },
  "userSettings": {
    "artifactReviewMode": "ARTIFACT_REVIEW_MODE_ALWAYS",
    "customThemeSeedsDark": {
      "background": "#101010",
      "foregroundOverride": "#FFFFFF",
      "primary": "#007acc"
    },
    "customThemeSeedsLight": {
      "background": "#FFFFFF",
      "foregroundOverride": "#101010",
      "primary": "#007acc"
    },
    "globalPermissionGrants": {
      "allow": [
        "command(brew info)",
        "command(cat)",
        "command(echo)",
        "command(find)",
        "command(git diff)",
        "command(git grep)",
        "command(git log)",
        "command(git ls-files)",
        "command(git ls-tree)",
        "command(git show)",
        "command(git status)",
        "command(grep)",
        "command(head)",
        "command(ls)",
        "command(npm info)",
        "command(npm search)",
        "command(npm view)",
        "command(tail)",
        "command(wc)",
        "command(which)",
        "read_url(agentskills.io)",
        "read_url(antigravity.google)",
        "read_url(chezmoi.io)",
        "read_url(code.visualstudio.com)",
        "read_url(docs.github.com)",
        "read_url(git-scm.com)",
        "read_url(raw.githubusercontent.com)"
      ]
    },
    "permissionGrantsV2Migrated": true,
    "remoteControlEnabled": true,
    "sandboxEnabledAtV2Migration": true,
    "themeMode": "THEME_MODE_INHERIT"
  }
}
