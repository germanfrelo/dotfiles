// Documentation: https://code.visualstudio.com/docs/editing/userdefinedsnippets
{
	"Insert table": {
		"prefix": "table",
		"body": [
			"",
			"| ${1:th} | ${2:th} | ${3:th} |",
			"| --- | --- | --- |",
			"| ${4:td} | ${5:td} | ${6:td} |",
			"| ${7:td} | ${8:td} | ${9:td} |",
			"${0}"
		],
		"description": "Insert table with 2 rows and 3 columns."
	},
	"Insert task list": {
		"prefix": "task",
		"body": [
			"",
			"- [${1| ,x|}] ${2:Item}",
			"${0}"
		],
		"description": "Insert task list."
	}
}
