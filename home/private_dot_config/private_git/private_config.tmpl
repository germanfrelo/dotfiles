[user]
	name = Germán Freixinós
	email = 14282156+germanfrelo@users.noreply.github.com

[init]
	defaultBranch = main

[help]
	autocorrect = prompt

# Display the number of entries currently stashed away.
[status]
	showStash = true

# Automatically use .git-blame-ignore-revs in any repo that has one.
# Ref. https://stackoverflow.com/a/79824780
[blame]
	ignoreRevsFile = :(optional).git-blame-ignore-revs

# Handle line endings properly.
# Ref. https://docs.github.com/en/get-started/git-basics/configuring-git-to-handle-line-endings
[core]
{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}
	autocrlf = input # macOS & Linux
{{- else if eq .chezmoi.os "windows" }}
	autocrlf = true # Windows
{{- else }}
	autocrlf = input
{{- end }}

# --- EXTERNAL TOOLS ---

# Editor
# https://git-scm.com/docs/git-config#Documentation/git-config.txt-coreeditor
# IMPORTANT: Do NOT set 'core.editor'. By default, Git uses the text editor defined via the '$VISUAL' shell environment variable in '$ZDOTDIR/.zshrc'. This is the desired behavior.

# Diff
# https://code.visualstudio.com/docs/sourcecontrol/merge-conflicts#_configure-vs-code-as-default-merge-tool
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

# Merge
# https://code.visualstudio.com/docs/sourcecontrol/merge-conflicts#_configure-vs-code-as-default-merge-tool
# https://code.visualstudio.com/updates/v1_70#_command-line-option-merge
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

# ---

# Commit signing with SSH and 1Password.
# Ref. https://developer.1password.com/docs/ssh/git-commit-signing/
[user]
	signingkey = {{ onepasswordRead "op://jzkvauzqt3adjmfkfl6ros3gc4/rzvcj7ec56xzr2ys5otprcvdsq/public_key" "VAEUN74C7FFWJITFMLLEXLAYFA" }}
[commit]
	gpgsign = true
[gpg]
	format = ssh
{{- if eq .chezmoi.os "darwin" }}
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
