# Define functions and completions.

# Create a new directory and instantly navigate into it (with folder tab-completion)
function md() { [[ $# == 1 ]] && mkdir -p -- "$1" && cd -- "$1" || return; }
compdef _directories md

# Adds the current commit to .git-blame-ignore-revs and commits the file.
#
# Validation tiers (case-insensitive):
#   - Allowed:    style (formatting changes that do not affect the meaning of the code).
#   - Ambiguous:  docs, chore, refactor (prints terminal notice; allowed if non-breaking).
#   - Restricted: feat, fix, perf, test, ci, build, or any breaking change (!).
#                 Aborts by default; requires -f / --force to override.
#
# Usage:
#   blame-ignore [-f | --force]
function blame-ignore() {
	local force=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-f | --force)
				force=1
				shift
				;;
			-h | --help)
				print "Usage: blame-ignore [-f|--force]"
				return 0
				;;
			*)
				print -P "%F{red}Error: Unknown option \"$1\". Usage: blame-ignore [-f|--force]%f" >&2
				return 1
				;;
		esac
	done

	local commit_hash short_hash commit_title title_lower new_hash repo_root ignore_file
	local msg_prefix="chore(git): Add commit "
	local msg_suffix=" to blame ignore list"

	repo_root="$(git rev-parse --show-toplevel 2> /dev/null)" || {
		print -P "%F{red}Error: not a git repository or no commits.%f" >&2
		return 1
	}
	commit_hash="$(git -C "${repo_root}" rev-parse HEAD 2> /dev/null)" || return 1
	short_hash="$(git -C "${repo_root}" rev-parse --short HEAD 2> /dev/null)"
	commit_title="$(git -C "${repo_root}" log -1 --format=%s)"
	title_lower="${commit_title:l}"
	ignore_file="${repo_root}/.git-blame-ignore-revs"

	if [[ "${title_lower}" == *"git-blame-ignore-revs"* ]] || [[ "${commit_title}" == "${msg_prefix}"*"${msg_suffix}" ]]; then
		print -P "%F{yellow}Skipped: The current commit (${short_hash}) is an automated update, which cannot be added to .git-blame-ignore-revs.%f" >&2
		return 1
	fi

	if [[ ! -f "${ignore_file}" ]]; then
		print -P "%F{red}Error: .git-blame-ignore-revs not found in ${repo_root}.%f" >&2
		return 1
	fi

	if grep -qF "${commit_hash}" "${ignore_file}"; then
		print -P "%F{yellow}Skipped: Commit ${short_hash} is already in .git-blame-ignore-revs.%f" >&2
		return 0
	fi

	case "${title_lower}" in
		style(|\(*\)):*)
			# Tier 1: Safe formatting — proceed silently
			;;
		(docs|chore|refactor)(|\(*\)):*)
			# Tier 2: Ambiguous — proceed with cautionary notice
			print -P "%F{yellow}Notice: Commit \"${commit_title}\" may contain functional changes. Ensure it is purely mechanical before ignoring.%f"
			;;
		*)
			# Tier 3: Restricted — requires force override
			if ((! force)); then
				if [[ "${title_lower}" == *'!'*:* || "${title_lower}" == *'!'* ]]; then
					print -P "%F{red}Aborted: Breaking changes (!) alter behavior and cannot be ignored by git blame (use --force to override).%f" >&2
				else
					print -P "%F{red}Aborted: \"${commit_title}\" is restricted. Use --force to override.%f" >&2
				fi
				return 1
			fi
			print -P "%F{yellow}Warning: Forcing ignore for restricted commit \"${commit_title}\".%f"
			;;
	esac

	printf "\n# %s\n%s\n" "${commit_title}" "${commit_hash}" >> "${ignore_file}"

	if git -C "${repo_root}" commit -q --no-verify --only .git-blame-ignore-revs -m "${msg_prefix}${short_hash}${msg_suffix}"; then
		new_hash="$(git -C "${repo_root}" rev-parse --short HEAD 2> /dev/null)"
		print -P "%F{green}Done: Added commit ${short_hash} to .git-blame-ignore-revs (created commit ${new_hash}).%f"
	else
		print -P "%F{red}Error: Failed to commit .git-blame-ignore-revs.%f" >&2
		return 1
	fi
}

