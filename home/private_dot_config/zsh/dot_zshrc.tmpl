# ==================================================

# Set shell options: https://zsh.sourceforge.io/Doc/Release/Options.html

setopt glob_dots    # no special treatment for file names with a leading dot
setopt no_auto_menu # require an extra TAB press to open the completion menu

# ==================================================

# Display custom messages above the prompt in new shell sessions.
# IMPORTANT: Keep at the end of .zshrc to prevent z4h from clearing these messages.

if ((SHLVL == 1)) && command -v chezmoi > /dev/null 2>&1; then
	# CHEZMOI:
	# Warn if 'chezmoi status' returns output.
	if [[ -n "$(chezmoi status 2> /dev/null)" ]]; then
		print -P "%F{yellow}chezmoi: warning: 'chezmoi status' is reporting changes, run it to review.%f"
	fi
	# Warn if 'chezmoi unmanaged' returns output.
	if [[ -n "$(chezmoi unmanaged 2> /dev/null)" ]]; then
		print -P "%F{yellow}chezmoi: warning: unmanaged files detected; run 'chezmoi unmanaged' to review.%f"
	fi
fi
