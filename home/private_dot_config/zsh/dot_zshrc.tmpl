# shellcheck shell=zsh

# =======================================================================
# Personal Zsh configuration file. It is strongly recommended to keep all
# shell customization and configuration (including exported environment
# variables such as PATH) in this file or in files sourced from it.
#
# Documentation: https://github.com/romkatv/zsh4humans/blob/v5/README.md

# =======================================================================

# Periodic auto-update on Zsh startup: 'ask' or 'no'.
# You can manually run `z4h update` to update everything.
zstyle ':z4h:' auto-update 'ask'
# Ask whether to auto-update this often; has no effect if auto-update is 'no'.
zstyle ':z4h:' auto-update-days '7'

# Keyboard type: 'mac' or 'pc'.
zstyle ':z4h:bindkey' keyboard 'mac'

# Start tmux if not already in tmux.
zstyle ':z4h:' start-tmux command tmux -u new -A -D -t z4h

# Whether to move prompt to the bottom when zsh starts and on Ctrl+L.
zstyle ':z4h:' prompt-at-bottom 'yes'

# Mark up shell's output with semantic information.
zstyle ':z4h:' term-shell-integration 'yes'

# Right-arrow key accepts one character ('partial-accept') from
# command autosuggestions or the whole thing ('accept')?
zstyle ':z4h:autosuggestions' forward-char 'accept'

# Recursively traverse directories when TAB-completing files.
zstyle ':z4h:fzf-complete' recurse-dirs 'no'

# Enable direnv to automatically source .envrc files.
zstyle ':z4h:direnv' enable 'yes'
# Show "loading" and "unloading" notifications from direnv.
zstyle ':z4h:direnv:success' notify 'yes'

# Enable ('yes') or disable ('no') automatic teleportation of z4h over
# SSH when connecting to these hosts.
zstyle ':z4h:ssh:example-hostname1' enable 'yes'
zstyle ':z4h:ssh:*.example-hostname2' enable 'no'
# The default value if none of the overrides above match the hostname.
zstyle ':z4h:ssh:*' enable 'no'

# Send these files over to the remote host when connecting over SSH to the
# enabled hosts.
# shellcheck disable=SC2088 # Tildes must stay literal so z4h resolves them on the remote machine.
zstyle ':z4h:ssh:*' send-extra-files '~/.nanorc' '~/.env.zsh'

# ==================================================

# Clone additional Git repositories from GitHub.
#
# This doesn't do anything apart from cloning the repository and keeping it
# up-to-date. Cloned files can be used after `z4h init`. This is just an
# example. If you don't plan to use Oh My Zsh, delete this line.
# z4h install ohmyzsh/ohmyzsh || return

# ==================================================

# Install or update core components (fzf, zsh-autosuggestions, etc.) and
# initialize Zsh. After this point console I/O is unavailable until Zsh
# is fully initialized. Everything that requires user interaction or can
# perform network I/O must be done above. Everything else is best done below.
z4h init || return

# ==================================================

# Extend PATH.
path=(~/bin $path)

# ==================================================

# Export environment variables.

# Preferred editor for CLI tools.

# VS Code
# https://code.visualstudio.com/docs/editor/command-line
export EDITOR="code --wait"
export VISUAL="code --wait"
# If not inside VS Code's integrated terminal, open a new window.
if [[ "$TERM_PROGRAM" != "vscode" ]]; then
	export EDITOR="code --wait --new-window"
	export VISUAL="code --wait --new-window"
fi

# GPG TTY for passphrase prompts
export GPG_TTY=$TTY

# User directories (XDG Base Directory Specification)
# Ref. https://wiki.archlinux.org/title/XDG_Base_Directory#User_directories
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"

# Homebrew
export HOMEBREW_NO_ANALYTICS=1

# NVM (Node Version Manager)
# Ref: https://github.com/romkatv/zsh4humans/issues/351
export NVM_DIR="${HOME}/.nvm"

# man / less
export LESSHISTFILE=- # avoid showing .lesshst file in $HOME when using `man' command

# Repositories
# Single source of truth for local repos and forks.
export REPOS_DIR="${REPOS_DIR:-$HOME/Developer/repos}"
export FORKS_DIR="${FORKS_DIR:-$HOME/Developer/forks}"

# ==================================================

# Source additional local files if they exist.

z4h source ~/.env.zsh

# Ref: https://github.com/romkatv/zsh4humans/issues/351
z4h source "${NVM_DIR}/nvm.sh" "${NVM_DIR}/bash_completion"

# ==================================================

# Use additional Git repositories pulled in with `z4h install`.
#
# This is just an example that you should delete. It does nothing useful.
# z4h source ohmyzsh/ohmyzsh/lib/diagnostics.zsh  # source an individual file
# z4h load   ohmyzsh/ohmyzsh/plugins/emoji-clock  # load a plugin

# ==================================================

# Define key bindings.

z4h bindkey undo Ctrl+/ Shift+Tab # undo the last command line change
z4h bindkey redo Option+/         # redo the last undone command line change

# z4h binds these to directory navigation by default internally.
# I explicitly bind them to 'z4h-do-nothing' to disable that behavior.
z4h bindkey z4h-do-nothing Shift+Left
z4h bindkey z4h-do-nothing Shift+Right
z4h bindkey z4h-do-nothing Shift+Up
z4h bindkey z4h-do-nothing Shift+Down

# ==================================================

# Autoload functions.

autoload -Uz zmv

# ==================================================

# Define functions and completions.

# Homebrew Background Sync Wrapper
_wrap_pkg_manager() {
	local tool="$1"
	shift
	local cmd="$1"

	# --- 1. EXECUTE THE NATIVE COMMAND IMMEDIATELY ---
	# This guarantees that even if the wrapper's logic completely fails later, your command (e.g. brew install X) will always run exactly as you intended.
	command "$tool" "$@"
	local exit_code=$?

	# If the command failed, or if we aren't in an interactive terminal, stop here.
	if [[ $exit_code -ne 0 ]] || [[ ! -t 0 ]]; then
		return $exit_code
	fi

	# --- 2. PARSE THE COMMAND ---
	local target=""
	local is_install=false
	local is_uninstall=false

	if [[ "$tool" == "brew" || "$tool" == "mas" ]]; then
		target="$2" # $1 was cmd
		if [[ "$cmd" == "install" ]]; then is_install=true; fi
		if [[ "$cmd" == "uninstall" ]]; then is_uninstall=true; fi
	elif [[ "$tool" == "npm" ]]; then
		if [[ "$*" == *"-g"* || "$*" == *"--global"* ]]; then
			for arg in "$@"; do
				# Skip cmd and flags to find the package name
				if [[ "$arg" != "$cmd" && "$arg" != "-"* ]]; then
					target="$arg"
					break
				fi
			done
			if [[ "$cmd" == "install" || "$cmd" == "i" ]]; then is_install=true; fi
			if [[ "$cmd" == "uninstall" || "$cmd" == "rm" ]]; then is_uninstall=true; fi
		fi
	fi

	# If this wasn't an install/uninstall command, we are done.
	if [[ ($is_install == false && $is_uninstall == false) || -z "$target" ]]; then
		return $exit_code
	fi

	# --- 3. BACKGROUND SYNC TO BREWFILE ---
	(
		local target_brewfile="${HOME}/.config/homebrew/{{ .machine_type }}/Brewfile"

		if [[ $is_install == true ]]; then
			if [[ "$tool" == "brew" ]]; then
				local cask_flag=""
				brew ls --cask "$target" >/dev/null 2>&1 && cask_flag="--cask"
				# word splitting is intended for $cask_flag here
				command brew bundle add "$target" $cask_flag --file="$target_brewfile" >/dev/null 2>&1
			elif [[ "$tool" == "mas" ]]; then
				if ! grep -q "id: ${target}" "$target_brewfile"; then
					echo "mas \"${target}\", id: ${target}" >>"$target_brewfile"
				fi
			elif [[ "$tool" == "npm" ]]; then
				command brew bundle add "$target" --npm --file="$target_brewfile" >/dev/null 2>&1
			fi
		elif [[ $is_uninstall == true ]]; then
			for bfile in "$common_file" "$personal_file" "$work_file"; do
				if [[ -f "$bfile" ]] && chezmoi managed "$bfile" >/dev/null 2>&1; then
					if [[ "$tool" == "brew" || "$tool" == "npm" ]]; then
						command brew bundle remove "$target" --file="$bfile" >/dev/null 2>&1
					elif [[ "$tool" == "mas" ]]; then
						sed -i '' "/id: ${target}/d" "$bfile"
					fi
				fi
			done
		fi
	) &!

	return $exit_code
}

brew() { _wrap_pkg_manager brew "$@"; }
mas() { _wrap_pkg_manager mas "$@"; }
npm() { _wrap_pkg_manager npm "$@"; }
# TODO: Explore VSCode extensions management considering ADR 0002 (Settings Sync)

# Create a new directory and instantly navigate into it (with folder tab-completion)
function md() { [[ $# == 1 ]] && mkdir -p -- "$1" && cd -- "$1" || return; }
compdef _directories md

# Adds the current commit to .git-blame-ignore-revs and commits the file.
#
# Validation tiers (case-insensitive):
#   - Allowed:    style (formatting changes that do not affect the meaning of the code).
#   - Ambiguous:  docs, chore, refactor (prints terminal notice; allowed if non-breaking).
#   - Restricted: feat, fix, perf, test, ci, build, or any breaking change (!).
#                 Aborts by default; requires -f / --force to override.
#
# Usage:
#   blame-ignore [-f | --force]
function blame-ignore() {
	local force=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-f | --force)
				force=1
				shift
				;;
			-h | --help)
				print "Usage: blame-ignore [-f|--force]"
				return 0
				;;
			*)
				print -P "%F{red}Error: Unknown option \"$1\". Usage: blame-ignore [-f|--force]%f" >&2
				return 1
				;;
		esac
	done

	local commit_hash short_hash commit_title title_lower new_hash repo_root ignore_file
	local msg_prefix="chore(git): Add commit "
	local msg_suffix=" to blame ignore list"

	repo_root="$(git rev-parse --show-toplevel 2> /dev/null)" || {
		print -P "%F{red}Error: not a git repository or no commits.%f" >&2
		return 1
	}
	commit_hash="$(git -C "${repo_root}" rev-parse HEAD 2> /dev/null)" || return 1
	short_hash="$(git -C "${repo_root}" rev-parse --short HEAD 2> /dev/null)"
	commit_title="$(git -C "${repo_root}" log -1 --format=%s)"
	title_lower="${commit_title:l}"
	ignore_file="${repo_root}/.git-blame-ignore-revs"

	if [[ "${title_lower}" == *"git-blame-ignore-revs"* ]] || [[ "${commit_title}" == "${msg_prefix}"*"${msg_suffix}" ]]; then
		print -P "%F{yellow}Skipped: The current commit (${short_hash}) is an automated update, which cannot be added to .git-blame-ignore-revs.%f" >&2
		return 1
	fi

	if [[ ! -f "${ignore_file}" ]]; then
		print -P "%F{red}Error: .git-blame-ignore-revs not found in ${repo_root}.%f" >&2
		return 1
	fi

	if grep -qF "${commit_hash}" "${ignore_file}"; then
		print -P "%F{yellow}Skipped: Commit ${short_hash} is already in .git-blame-ignore-revs.%f" >&2
		return 0
	fi

	case "${title_lower}" in
		style(|\(*\)):*)
			# Tier 1: Safe formatting — proceed silently
			;;
		(docs|chore|refactor)(|\(*\)):*)
			# Tier 2: Ambiguous — proceed with cautionary notice
			print -P "%F{yellow}Notice: Commit \"${commit_title}\" may contain functional changes. Ensure it is purely mechanical before ignoring.%f"
			;;
		*)
			# Tier 3: Restricted — requires force override
			if ((! force)); then
				if [[ "${title_lower}" == *'!'*:* || "${title_lower}" == *'!'* ]]; then
					print -P "%F{red}Aborted: Breaking changes (!) alter behavior and cannot be ignored by git blame (use --force to override).%f" >&2
				else
					print -P "%F{red}Aborted: \"${commit_title}\" is restricted. Use --force to override.%f" >&2
				fi
				return 1
			fi
			print -P "%F{yellow}Warning: Forcing ignore for restricted commit \"${commit_title}\".%f"
			;;
	esac

	printf "\n# %s\n%s\n" "${commit_title}" "${commit_hash}" >> "${ignore_file}"

	if git -C "${repo_root}" commit -q --no-verify --only .git-blame-ignore-revs -m "${msg_prefix}${short_hash}${msg_suffix}"; then
		new_hash="$(git -C "${repo_root}" rev-parse --short HEAD 2> /dev/null)"
		print -P "%F{green}Done: Added commit ${short_hash} to .git-blame-ignore-revs (created commit ${new_hash}).%f"
	else
		print -P "%F{red}Error: Failed to commit .git-blame-ignore-revs.%f" >&2
		return 1
	fi
}

# ==================================================

# Define named directories: ~w <=> Windows home directory on WSL.

[[ -z $z4h_win_home ]] || hash -d w=$z4h_win_home

# ==================================================

# Define aliases.

# Editors

# VS Code: if not inside its integrated terminal, open a new window.
if [[ "$TERM_PROGRAM" != "vscode" ]]; then
	alias code="code --new-window"
fi

# Files and directories

# Recently visited directories
# List
alias dirs="dirs -v"
# Quick access by index
# shellcheck disable=SC2139 # The loop variable must expand when defined, before it is unset on the next line.
for index in {1..9}; do alias "${index}"="cd +${index}"; done
unset index

# Quick-access directories
alias repos='${REPOS_DIR}'

# List all files and directories in columns
alias eza="eza --classify --all --group-directories-first"
# Same as above, but displaying extended metadata as a table
alias ezal="eza --long --header --smart-group --flags --time-style=iso --no-user --git-repos"
# Show the contents of the current directory as a tree, including hidden files and directories
alias tree="tree -a"
alias tree1="tree -L 1"
alias tree2="tree -L 2"
alias tree3="tree -L 3"

# File contents
alias bat="bat --paging=never"

# Find patterns in files using regular expressions
alias grep="grep --ignore-case"

# Actions on files and directories
alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -iv"

# Git
alias gl="git log --oneline --graph"
alias gla="gl --all"
alias gls="gl --stat"
alias glt="git log --graph --pretty=format:'%C(yellow)%h%Creset%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset'"
alias gunstage="git restore --staged ." # restore the index
alias gstashu="git stash --include-untracked"
alias gstat="git status --short --branch"
