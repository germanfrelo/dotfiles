{
	"files.associations": {
		// Associates non-standard chezmoi filenames (dot_* prefixes, *.tmpl templates) with their intended languages.
		"*.json.tmpl": "json",
		"*.sh.tmpl": "shellscript",
		"*.toml.tmpl": "toml",
		"**/*git/*config*": "ini",
		"**/*ncdu/*config*": "properties",
		"*dot_editorconfig": "editorconfig",
		"*ignore": "ignore",
		"*npmrc": "properties", // See https://github.com/microsoft/vscode/pull/92397
		"*p10k.zsh": "plaintext",
		"*zprofile": "shellscript",
		"*zshenv": "shellscript",
		"*zshrc": "shellscript"
	}
}
