{
	"[shellscript]": {
		"editor.codeActionsOnSave": {
			"source.fixAll.shellLsp": "explicit"
		},
		"editor.defaultFormatter": "stubbedev.shell-lsp"
	},
	"files.associations": {
		// Associates non-standard chezmoi filenames (dot_* prefixes, *.tmpl templates) with their intended languages.
		"*.json.tmpl": "json",
		"*.sh.tmpl": "shellscript",
		"*.toml.tmpl": "toml",
		"**/*git/*config*": "ini",
		"**/*ncdu/*config*": "properties",
		"**/*ssh/*config*": "ssh_config",
		"*dot_editorconfig": "editorconfig",
		"*ignore": "ignore",
		"*npmrc": "properties", // See https://github.com/microsoft/vscode/pull/92397
		"*p10k.zsh": "plaintext",
		"*zprofile": "shellscript",
		"*zshenv": "shellscript",
		"*zshrc": "shellscript"
	},
	"shellLsp.format.spaceRedirects": true,
	"shellLsp.format.switchCaseIndent": true
}
